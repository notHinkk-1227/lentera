# Salin file ini jadi .env lalu isi sesuai environment kamu.

# Connection string PostgreSQL (lokal saat development, cloud/Supabase/Neon saat production)
DATABASE_URL="postgresql://user:password@localhost:5432/lentera"

# Secret untuk NextAuth — generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string"

# Wajib di production: URL publik aplikasi (mis. https://lentera.widyatama.ac.id)
# AUTH_URL=""

# Diisi kalau nanti pakai Vercel Blob untuk storage production
# BLOB_READ_WRITE_TOKEN=""

# Folder berkas PDF unggahan saat development (default: ./.uploads, di luar /public sehingga
# tidak bisa diakses langsung; PDF hanya disajikan lewat /api/articles/[id]/download).
# UPLOAD_DIR=""
