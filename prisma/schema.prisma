// Skema database awal — Repositori Karya Ilmiah Dosen
// Lihat PRD.md dan CLAUDE.md untuk konteks lengkap.
// Detail field masih bisa disesuaikan bersama sebelum development lanjut.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOSEN
}

enum ArticleStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum WorkType {
  RESEARCH // hasil penelitian
  PKM      // pengabdian kepada masyarakat
}

enum Region {
  LOKAL         // Kota Bandung
  REGIONAL      // Jawa Barat & provinsi lain
  NASIONAL
  INTERNASIONAL
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(DOSEN)
  faculty      Faculty?  @relation(fields: [facultyId], references: [id])
  facultyId    String?
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Faculty {
  id       String    @id @default(cuid())
  name     String    @unique
  users    User[]
  articles Article[]

  @@map("faculties")
}

model Category {
  id       String            @id @default(cuid())
  name     String            @unique
  articles ArticleCategory[]

  @@map("categories")
}

// Tabel penghubung many-to-many antara Article dan Category
model ArticleCategory {
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([articleId, categoryId])
  @@map("article_categories")
}

model Article {
  id            String            @id @default(cuid())
  title         String
  abstract      String
  keywords      String[]
  year          Int
  status        ArticleStatus     @default(PENDING)
  rejectedNote  String?

  fileUrl       String
  coverUrl      String?

  downloadCount Int               @default(0)

  author        User              @relation(fields: [authorId], references: [id])
  authorId      String

  faculty       Faculty           @relation(fields: [facultyId], references: [id])
  facultyId     String

  categories    ArticleCategory[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime?

  // --- Roadmap Penelitian & PkM ---
  type             WorkType        @default(RESEARCH)
  roadmapTopicId   String?
  roadmapTopic     RoadmapTopic?   @relation(fields: [roadmapTopicId], references: [id])
  themes           ResearchTheme[]
  pkmFocusAreas    PkmFocusArea[]
  region           Region?         // hanya untuk PKM
  partner          String?         // mitra / desa binaan (opsional)

  // PkM sebagai kelanjutan hasil riset ("riset -> PkM")
  sourceResearchId String?
  sourceResearch   Article?        @relation("ResearchToPkm", fields: [sourceResearchId], references: [id])
  pkmFollowUps     Article[]       @relation("ResearchToPkm")

  @@index([type, status])
  @@map("articles")
}

// ===== Roadmap Penelitian & PkM (Renstra 2024–2028) =====

// 4 spesialisasi riset unggulan: Sustainability, Inovasi Teknologi,
// Rich Content and Value, Kolaborasi dan Kreativitas
model ResearchStream {
  id     String          @id @default(cuid())
  slug   String          @unique
  name   String          @unique
  themes ResearchTheme[]
  topics RoadmapTopic[]
}

// 10 tema penelitian unggulan (Tabel 2): Humaniora, Pangan, Energi, dst.
// Many-to-many ke spesialisasi (bidang fokus) DAN ke Article.
model ResearchTheme {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String           @unique
  streams  ResearchStream[]
  articles Article[]
}

// 6 bidang fokus PkM (berlaku lintas tahun)
model PkmFocusArea {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  articles Article[]
}

// Satu Topik Besar PkM per tahun (roadmap PkM berbentuk linear)
model RoadmapYear {
  year     Int            @id
  pkmTheme String
  topics   RoadmapTopic[]
}

// Satu baris roadmap, mis. "2024-A-Strategi Bisnis Berkelanjutan".
// Kode "2024-A" TIDAK unik lintas spesialisasi, jadi unik-nya lewat slug:
//   research-sustainability-2024-a  |  pkm-2024-a
model RoadmapTopic {
  id       String         @id @default(cuid())
  slug     String         @unique
  type     WorkType
  year     Int
  code     String         // "A", "B", ...
  title    String
  streamId String?        // hanya untuk RESEARCH
  stream   ResearchStream? @relation(fields: [streamId], references: [id])
  roadmapYear RoadmapYear @relation(fields: [year], references: [year])
  articles Article[]

  @@index([type, year])
}
