// Skema database awal — Repositori Karya Ilmiah Dosen
// Lihat PRD.md dan CLAUDE.md untuk konteks lengkap.
// Detail field masih bisa disesuaikan bersama sebelum development lanjut.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOSEN
}

enum ArticleStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum WorkType {
  RESEARCH // hasil penelitian
  PKM      // pengabdian kepada masyarakat
}

enum Region {
  LOKAL         // Kota Bandung
  REGIONAL      // Jawa Barat & provinsi lain
  NASIONAL
  INTERNASIONAL
}

enum AuthorType {
  DOSEN
  MAHASISWA
  EKSTERNAL
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(DOSEN)
  faculty      Faculty?  @relation(fields: [facultyId], references: [id])
  facultyId    String?
  isActive     Boolean   @default(true) // akun nonaktif tidak bisa login
  articles     Article[] // karya yang DIUNGGAH akun ini (bukan daftar penulis)
  author       Author?   // profil penulis milik akun ini (bila ada)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Faculty {
  id       String    @id @default(cuid())
  name     String    @unique
  users    User[]
  articles Article[]

  @@map("faculties")
}

model Category {
  id       String            @id @default(cuid())
  name     String            @unique
  articles ArticleCategory[]

  @@map("categories")
}

// Tabel penghubung many-to-many antara Article dan Category
model ArticleCategory {
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([articleId, categoryId])
  @@map("article_categories")
}

model Article {
  id            String            @id @default(cuid())
  title         String
  abstract      String
  keywords      String[]
  year          Int
  status        ArticleStatus     @default(PENDING)
  rejectedNote  String?

  // Tautan unduh berkas di situs lain (repositori/jurnal). LENTERA tidak menyimpan PDF sendiri.
  // Diakses publik lewat /api/articles/[id]/download (menghitung unduhan lalu redirect).
  downloadUrl   String?
  coverUrl      String?

  downloadCount Int               @default(0)

  // Pengunggah (dosen yang login). Penulis karya ada di `authors` — keduanya bisa berbeda.
  uploader      User              @relation(fields: [uploaderId], references: [id])
  uploaderId    String

  faculty       Faculty           @relation(fields: [facultyId], references: [id])
  facultyId     String

  categories    ArticleCategory[]
  authors       ArticleAuthor[]
  sdgs          ArticleSdg[]

  // Tautan eksternal (FR-EXT-*). Tautan Google Scholar dibentuk dari judul bila scholarUrl kosong.
  doi           String?
  scopusUrl     String?
  scholarUrl    String?
  sintaUrl      String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  publishedAt   DateTime?

  // --- Roadmap Penelitian & PkM ---
  type             WorkType        @default(RESEARCH)
  roadmapTopicId   String?
  roadmapTopic     RoadmapTopic?   @relation(fields: [roadmapTopicId], references: [id])
  themes           ResearchTheme[]
  pkmFocusAreas    PkmFocusArea[]
  region           Region?         // hanya untuk PKM
  partner          String?         // mitra / desa binaan (opsional)

  // PkM sebagai kelanjutan hasil riset ("riset -> PkM")
  sourceResearchId String?
  sourceResearch   Article?        @relation("ResearchToPkm", fields: [sourceResearchId], references: [id])
  pkmFollowUps     Article[]       @relation("ResearchToPkm")

  @@index([type, status])
  @@map("articles")
}

// --- Penulis & SDG ------------------------------------------------------------------

// Penulis karya. Dosen internal biasanya terhubung ke akun (`userId`); mahasiswa dan penulis
// eksternal berdiri sendiri tanpa akun.
model Author {
  id          String          @id @default(cuid())
  name        String
  type        AuthorType      @default(DOSEN)
  affiliation String? // fakultas/prodi (internal) atau instansi (eksternal)
  user        User?           @relation(fields: [userId], references: [id])
  userId      String?         @unique
  articles    ArticleAuthor[]
  createdAt   DateTime        @default(now())

  @@index([name])
  @@map("authors")
}

// Penulis berurutan pada sebuah karya. `position` mulai dari 1; `corresponding` menandai
// penulis korespondensi.
model ArticleAuthor {
  article       Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId     String
  author        Author  @relation(fields: [authorId], references: [id])
  authorId      String
  position      Int
  corresponding Boolean @default(false)

  @@id([articleId, authorId])
  @@index([articleId, position])
  @@index([authorId])
  @@map("article_authors")
}

// 17 Tujuan Pembangunan Berkelanjutan. `number` (1..17) langsung jadi kunci. Warna dan ikon
// tetap di lib/sdg.ts karena murni urusan tampilan.
model Sdg {
  number    Int          @id
  name      String
  shortName String
  articles  ArticleSdg[]

  @@map("sdgs")
}

model ArticleSdg {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  sdg       Sdg     @relation(fields: [sdgNumber], references: [number])
  sdgNumber Int

  @@id([articleId, sdgNumber])
  @@index([sdgNumber])
  @@map("article_sdgs")
}

// ===== Roadmap Penelitian & PkM (Renstra 2024–2028) =====

// 4 spesialisasi riset unggulan: Sustainability, Inovasi Teknologi,
// Rich Content and Value, Kolaborasi dan Kreativitas
model ResearchStream {
  id     String          @id @default(cuid())
  slug   String          @unique
  name   String          @unique
  themes ResearchTheme[]
  topics RoadmapTopic[]
}

// 10 tema penelitian unggulan (Tabel 2): Humaniora, Pangan, Energi, dst.
// Many-to-many ke spesialisasi (bidang fokus) DAN ke Article.
model ResearchTheme {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String           @unique
  streams  ResearchStream[]
  articles Article[]
}

// 6 bidang fokus PkM (berlaku lintas tahun)
model PkmFocusArea {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  articles Article[]
}

// Satu Topik Besar PkM per tahun (roadmap PkM berbentuk linear)
model RoadmapYear {
  year     Int            @id
  pkmTheme String
  topics   RoadmapTopic[]
}

// Satu baris roadmap, mis. "2024-A-Strategi Bisnis Berkelanjutan".
// Kode "2024-A" TIDAK unik lintas spesialisasi, jadi unik-nya lewat slug:
//   research-sustainability-2024-a  |  pkm-2024-a
model RoadmapTopic {
  id       String         @id @default(cuid())
  slug     String         @unique
  type     WorkType
  year     Int
  code     String         // "A", "B", ...
  title    String
  streamId String?        // hanya untuk RESEARCH
  stream   ResearchStream? @relation(fields: [streamId], references: [id])
  roadmapYear RoadmapYear @relation(fields: [year], references: [year])
  articles Article[]

  @@index([type, year])
}
